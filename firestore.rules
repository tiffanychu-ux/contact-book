rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 可以修改聯絡簿的老師帳號（要和 js/firebase-config.js 的 ADMIN_EMAIL 一致）
    function isTeacher() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email.lower() == 'tiffanychu@phy.ncu.edu.tw';
    }

    // 線上聯絡簿：家長只能看「已發布」的週次；只有老師能新增、修改、刪除
    match /weeks/{weekId} {
      allow read: if resource.data.published == true || isTeacher();
      allow create, update: if isTeacher()
        && request.resource.data.no is int
        && weekId == 'w' + string(request.resource.data.no);
      allow delete: if isTeacher();
    }

    // ⚠ 如果這個 Firebase 專案原本就有其他程式在用資料庫，
    //   請把它們原本的規則一起保留在這個區塊裡，不要整個覆蓋掉。
  }
}
